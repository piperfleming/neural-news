# Copy to .env and fill in. Do NOT commit .env (it contains secrets).

# ── Database ──────────────────────────────────────────────────
# Option A — Shared cloud Postgres (Neon, recommended for team dev):
#   1. Sign up free at https://neon.tech
#   2. Create a project → copy the connection string
#   3. Convert the scheme from "postgresql://" to "postgresql+asyncpg://"
#   4. Keep "?sslmode=require" at the end (required for cloud)
#
#   Example:
#   DATABASE_URL=postgresql+asyncpg://neondb_owner:abc123@ep-cool-name-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Option B — Local Postgres (offline development):
#   DATABASE_URL=postgresql+asyncpg://jack_admin:parsley194@localhost:5432/parsley_db

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-api-key-here

# ── Auth / JWT (optional, has safe defaults) ──────────────────
# JWT_SECRET_KEY=change-me-in-production
# JWT_EXPIRATION_MINUTES=1440
