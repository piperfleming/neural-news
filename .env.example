# Copy to .env and fill in. Do NOT commit .env (it contains secrets).
#
# With Docker:   cp .env.example .env   then   docker compose up
# Without Docker: cp .env.example backend/.env   (see README for details)

# ── Database ──────────────────────────────────────────────────
# Docker default (auto-configured by docker-compose, override if needed):
#   DATABASE_URL is set automatically via docker-compose.yml environment block.
#   You only need to set it here if you want to use a cloud database instead.
#
# Neon (cloud Postgres — shared team dev):
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
#
# Local Postgres (without Docker):
#   DATABASE_URL=postgresql+asyncpg://neuralnews:neuralnews@localhost:5432/neuralnews

# ── Docker Postgres settings (used by docker-compose) ────────
POSTGRES_USER=neuralnews
POSTGRES_PASSWORD=neuralnews
POSTGRES_DB=neuralnews

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-api-key-here

# ── Auth / JWT (optional, has safe defaults) ──────────────────
# JWT_SECRET_KEY=change-me-in-production
# JWT_EXPIRATION_MINUTES=1440

# ── Admin access (optional) ────────────────────────────────────
# Comma-separated list of emails that should see the admin dashboard.
# ADMIN_EMAILS=admin1@example.com,admin2@example.com
